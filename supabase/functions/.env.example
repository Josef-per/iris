# Copie para supabase/functions/.env. Nunca use estes valores no Flutter.
OPENAI_API_KEY=substitua-pelo-secret-do-backend
OPENAI_MODEL=snapshot-avaliado-e-aprovado
AI_SUPPORT_SAFETY_SALT=substitua-por-valor-aleatorio-longo
AI_SUPPORT_ENVIRONMENT=development
AI_SUPPORT_ALLOWED_ORIGINS=http://localhost:3000
OPENAI_TIMEOUT_MS=6000
